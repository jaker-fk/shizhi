# 复制为 .env 后修改成自己的密码；不要提交真实密码。
MYSQL_DATABASE=shizhi
MYSQL_USER=shizhi
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# 会话有效期（天）与 Cookie 安全属性
# 使用 HTTPS 的公网部署请改为 true
SESSION_DAYS=14
COOKIE_SECURE=false
# 关闭公开注册后，只有数据库中还没有用户时仍允许创建第一个账号
ALLOW_REGISTRATION=true
